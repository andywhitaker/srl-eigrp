delete / acl acl-filter cpm type ipv4 entry 88
/ acl acl-filter cpm type ipv4 entry 88 description "Accept EIGRP IP protocol 88"
/ acl acl-filter cpm type ipv4 entry 88 match ipv4 protocol 88
/ acl acl-filter cpm type ipv4 entry 88 action accept

delete / acl acl-filter cpm type ipv6 entry 88
/ acl acl-filter cpm type ipv6 entry 88 description "Accept EIGRP IPv6 next-header 88"
/ acl acl-filter cpm type ipv6 entry 88 match ipv6 next-header 88
/ acl acl-filter cpm type ipv6 entry 88 action accept

/ interface ethernet-1/1 admin-state enable
/ interface ethernet-1/1 vlan-tagging true
/ interface ethernet-1/1 subinterface 0 admin-state enable
/ interface ethernet-1/1 subinterface 0 vlan encap single-tagged vlan-id 1
/ interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
/ interface ethernet-1/1 subinterface 0 ipv4 address 10.0.0.2/30
/ interface ethernet-1/1 subinterface 0 ipv6 admin-state enable
/ interface ethernet-1/1 subinterface 0 ipv6 address 2001:db8:1::2/64

/ interface ethernet-1/1 subinterface 1 admin-state enable
/ interface ethernet-1/1 subinterface 1 vlan encap single-tagged vlan-id 10
/ interface ethernet-1/1 subinterface 1 ipv4 admin-state enable
/ interface ethernet-1/1 subinterface 1 ipv4 address 10.1.0.2/30

/ interface system0 admin-state enable
/ interface system0 subinterface 0 admin-state enable
/ interface system0 subinterface 0 ipv4 admin-state enable
/ interface system0 subinterface 0 ipv4 address 192.0.2.2/32
/ interface system0 subinterface 0 ipv6 admin-state enable
/ interface system0 subinterface 0 ipv6 address 2001:db8::2/128

/ interface lo0 admin-state enable
/ interface lo0 subinterface 1 admin-state enable
/ interface lo0 subinterface 1 ipv4 admin-state enable
/ interface lo0 subinterface 1 ipv4 address 192.0.2.22/32

/ network-instance default interface ethernet-1/1.0
/ network-instance default interface system0.0

/ network-instance default protocols eigrp admin-state enable
/ network-instance default protocols eigrp autonomous-system 100
/ network-instance default protocols eigrp router-id 192.0.2.2
/ network-instance default protocols eigrp default-interface admin-state enable
/ network-instance default protocols eigrp interface ethernet-1/1.0 admin-state enable
/ network-instance default protocols eigrp interface system0.0 admin-state enable passive true

/ network-instance vrf-1 type ip-vrf admin-state enable
/ network-instance vrf-1 interface ethernet-1/1.1
/ network-instance vrf-1 interface lo0.1

/ network-instance vrf-1 protocols eigrp admin-state enable
/ network-instance vrf-1 protocols eigrp autonomous-system 200
/ network-instance vrf-1 protocols eigrp router-id 192.0.2.22
/ network-instance vrf-1 protocols eigrp default-interface admin-state enable
/ network-instance vrf-1 protocols eigrp interface ethernet-1/1.1 admin-state enable
/ network-instance vrf-1 protocols eigrp interface lo0.1 admin-state enable passive true
